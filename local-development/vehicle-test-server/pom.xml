    <dependency><groupId>com.domed</groupId><artifactId>domed-manage-api</artifactId><version>0.0.1-SNAPSHOT</version><exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
    <dependency><groupId>com.domed</groupId><artifactId>domed-foundation</artifactId><version>0.0.1-SNAPSHOT</version><exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
